# ============================================================
# Ghostty — Fog & Ember
# ============================================================

theme = fog-and-ember

# ------------------------------------------------------------
# Шрифт
# ------------------------------------------------------------

font-family = "JetBrainsMono Nerd Font"
font-family-bold = "JetBrainsMono Nerd Font"
font-family-italic = "JetBrainsMono Nerd Font"
font-family-bold-italic = "JetBrainsMono Nerd Font"

font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = "Bold Italic"

font-size = 16

# Отключаем программные лигатуры для строгого рендеринга.
font-feature = -calt, -liga, -dlig

# Аналог draw_bold_text_with_bright_colors.
bold-color = bright

# ------------------------------------------------------------
# Курсор
# ------------------------------------------------------------

cursor-style = bar
cursor-style-blink = true

# Не позволяем shell integration менять курсор на свой.
shell-integration-features = no-cursor

# ------------------------------------------------------------
# Окно
# ------------------------------------------------------------

background-opacity = 0.84

# Прозрачность также внутри приложений, которые сами рисуют фон:
# tmux, Neovim, superfile и другие TUI.
background-opacity-cells = true

window-padding-x = 12
window-padding-y = 8
window-padding-balance = false
window-padding-color = background

# Минималистичный внешний вид под Hyprland.
window-decoration = none
window-show-tab-bar = never
resize-overlay = never
scrollbar = never

# ------------------------------------------------------------
# Shell
# ------------------------------------------------------------

command = /bin/zsh

# TERM вручную не задаём:
# Ghostty самостоятельно устанавливает xterm-ghostty.

# ------------------------------------------------------------
# История и прокрутка
# ------------------------------------------------------------

# В Ghostty история задаётся байтами, а не количеством строк.
# 64 MiB — практический аналог большого history=100000.
scrollback-limit = 67108864

mouse-scroll-multiplier = 6
mouse-hide-while-typing = false

# ------------------------------------------------------------
# Выделение и буфер обмена
# ------------------------------------------------------------

# Копировать выделение и в primary selection, и в clipboard.

selection-word-chars = ",│`|:\"' ()[]{}<>\t"

# Стандартные сочетания буфера обмена задаются ниже.

# ------------------------------------------------------------
# Буфер обмена
# ------------------------------------------------------------

# Не копировать текст при простом выделении мышью.
copy-on-select = false

# Не показывать всплывашки при копировании и очистке буфера.
# Остальные уведомления Ghostty, например о перезагрузке конфига,
# останутся включены.
app-notifications = no-clipboard-copy

# Обычные сочетания копирования и вставки.
keybind = performable:ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
