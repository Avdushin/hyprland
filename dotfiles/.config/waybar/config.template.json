[
  {
    "output": "@LEFT@",
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,
    "margin-top": 7,
    "margin-left": 9,
    "margin-right": 9,
    "modules-left": [
      "hyprland/workspaces"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "cpu#side",
      "memory#side",
      "custom/language",
      "pulseaudio#side",
      "network#side"
    ],
    "hyprland/workspaces": {
      "all-outputs": false,
      "disable-scroll": true,
      "sort-by-number": true,
      "format": "{icon}",
      "format-icons": {
        "0": "0",
        "default": ""
      },
      "on-click": "activate",
      "persistent-workspaces": {
        "0": [
          "@LEFT@"
        ]
      },
      "expand": false,
      "show-special": false
    },
    "clock": {
      "format": "󰥔  {:%a, %d %b  ·  %H:%M}",
      "locale": "ru_RU.UTF-8",
      "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>\n\nЛКМ — открыть calcurse",
      "on-click": "alacritty -e calcurse"
    },
    "cpu#side": {
      "interval": 2,
      "format": "󰍛 {usage}%",
      "states": {
        "warning": 70,
        "critical": 90
      },
      "tooltip": true,
      "on-click": "alacritty -e btop",
      "expand": false
    },
    "memory#side": {
      "interval": 3,
      "format": "󰘚 {used:0.1f} ГБ",
      "states": {
        "warning": 80,
        "critical": 92
      },
      "tooltip-format": "ОЗУ: {used:0.1f} / {total:0.1f} ГиБ\nЛКМ — открыть btop",
      "on-click": "alacritty -e btop",
      "expand": false
    },
    "custom/language": {
      "exec": "python3 $HOME/.config/waybar/scripts/language.py",
      "return-type": "json",
      "restart-interval": 2,
      "exec-on-event": false,
      "on-click": "bash $HOME/.config/waybar/scripts/language-toggle.sh",
      "tooltip": true,
      "expand": false
    },
    "pulseaudio#side": {
      "scroll-step": 2,
      "format": "{icon} {volume}%",
      "format-muted": "󰖁",
      "format-icons": {
        "headphone": [
          "",
          "",
          ""
        ],
        "headset": [
          "",
          "",
          ""
        ],
        "speaker": [
          "",
          "",
          ""
        ],
        "default": [
          "",
          "",
          ""
        ]
      },
      "format-bluetooth": "{icon} {volume}%",
      "on-click": "pavucontrol",
      "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "expand": false
    },
    "network#side": {
      "format-wifi": "{icon}",
      "format-ethernet": "󰈀",
      "format-linked": "󰈂",
      "format-disconnected": "󰤭",
      "format-disabled": "󰤭",
      "format-icons": [
        "󰤯",
        "󰤟",
        "󰤢",
        "󰤥",
        "󰤨"
      ],
      "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}",
      "tooltip-format-ethernet": "Ethernet  {ipaddr}",
      "tooltip-format-disconnected": "Сеть отключена",
      "on-click": "bash $HOME/.config/waybar/scripts/wifi-menu.sh",
      "on-click-right": "nm-connection-editor",
      "interval": 5,
      "expand": false
    },
    "on-sigusr2": "reload"
  },
  {
    "output": "@CENTER@",
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,
    "margin-top": 7,
    "margin-left": 9,
