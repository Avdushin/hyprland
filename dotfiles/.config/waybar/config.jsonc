{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 0,
  "margin-top": 7,
  "margin-left": 9,
  "margin-right": 9,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["mpris", "cpu", "memory", "custom/language", "bluetooth", "pulseaudio", "network", "tray", "custom/power"],

  "hyprland/workspaces": {
    "all-outputs": false,
    "disable-scroll": true,
    "sort-by-number": true,
    "format": "{name}",
    "on-click": "activate",
    "show-special": false
  },

  "clock": {
    "format": "{:%a, %d %b  ·  %H:%M}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "mpris": {
    "format": "{player_icon} {artist} — {title}",
    "format-paused": " {artist} — {title}",
    "player-icons": {"default": ""},
    "max-length": 30,
    "on-click": "playerctl play-pause",
    "on-click-middle": "playerctl next",
    "on-click-right": "playerctl previous"
  },

  "cpu": {
    "interval": 2,
    "format": "CPU {usage}%",
    "tooltip": true
  },

  "memory": {
    "interval": 3,
    "format": "RAM {used:0.1f}G",
    "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB"
  },

  "custom/language": {
    "exec": "python3 $HOME/.config/waybar/scripts/language.py",
    "return-type": "json",
    "restart-interval": 2,
    "exec-on-event": false,
    "on-click": "bash $HOME/.config/waybar/scripts/language-toggle.sh",
    "tooltip": true
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-off": "",
    "format-connected": " {num_connections}",
    "tooltip-format": "Bluetooth: {status}",
    "on-click": "bash $HOME/.config/waybar/scripts/bluetooth-menu.sh",
    "on-click-right": "blueman-manager"
  },

  "pulseaudio": {
    "scroll-step": 2,
    "format": " {volume}%",
    "format-muted": "",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}",
    "tooltip-format-ethernet": "Ethernet  {ipaddr}",
    "on-click": "bash $HOME/.config/waybar/scripts/wifi-menu.sh",
    "on-click-right": "nm-connection-editor",
    "interval": 5
  },

  "tray": {"spacing": 8},

  "custom/power": {
    "format": "",
    "tooltip": "Power menu",
    "on-click": "bash $HOME/.config/hypr/scripts/powermenu.sh"
  }
}
