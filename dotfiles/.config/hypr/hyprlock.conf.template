general {
    disable_loading_bar = true
    hide_cursor = true
    grace = 0
}

background {
    monitor =
    path = screenshot
    color = rgb(@BASE@)
    blur_passes = 2
    blur_size = 5
    noise = 0.008
    contrast = 0.92
    brightness = 0.50
    vibrancy = 0.04
}

label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = rgb(@TEXT@)
    font_size = 72
    font_family = JetBrains Mono
    position = 0, 170
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] date +"%A, %d %B"
    color = rgb(@MUTED@)
    font_size = 18
    font_family = JetBrains Mono
    position = 0, 110
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 340, 56
    outline_thickness = 2
    dots_size = 0.22
    dots_spacing = 0.28
    dots_center = true
    outer_color = rgb(@ACCENT@)
    inner_color = rgba(@SURFACE@f2)
    font_color = rgb(@TEXT@)
    fade_on_empty = false
    placeholder_text = <span foreground="##@MUTED@">Password…</span>
    hide_input = false
    check_color = rgb(@SUCCESS@)
    fail_color = rgb(@CRITICAL@)
    fail_text = <i>$FAIL <b>($ATTEMPTS)</b></i>
    capslock_color = rgb(@WARNING@)
    position = 0, -15
    halign = center
    valign = center
}

label {
    monitor =
    text = $LAYOUT
    color = rgb(@MUTED@)
    font_size = 13
    font_family = JetBrains Mono
    position = 0, -70
    halign = center
    valign = center
}
